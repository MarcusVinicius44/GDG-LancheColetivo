# Copie para .env.local e preencha (Console Firebase > Configurações do projeto > Seus apps > Web).
VITE_FIREBASE_API_KEY=
# Domínio do Hosting (ex.: SEU-PROJECT-ID.web.app) ou domínio customizado: necessário p/ login por redirect no Safari.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-lanche-coletivo
VITE_FIREBASE_APP_ID=
# true = usa Auth/Firestore Emulators locais
VITE_USE_EMULATORS=true
